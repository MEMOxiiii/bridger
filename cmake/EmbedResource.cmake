# bridger_embed_resource(<target> <input-file> <symbol>)
#
# Embeds a binary file (e.g. the compiled .brmap mapping blob or SPIR-V shaders)
# into <target>. Generates a .cpp defining:
#
#   namespace bridger::embedded {
#   extern const unsigned char <symbol>[];
#   extern const std::size_t   <symbol>_size;
#   }
#
# The generated source is rebuilt whenever the input changes.

set(_BRIDGER_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/EmbedResource.cmake")

function(bridger_embed_resource target input symbol)
    get_filename_component(input_abs "${input}" ABSOLUTE)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded/${symbol}.cpp")
    add_custom_command(
        OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}"
            -DBRIDGER_EMBED_INPUT=${input_abs}
            -DBRIDGER_EMBED_OUTPUT=${output}
            -DBRIDGER_EMBED_SYMBOL=${symbol}
            -P "${_BRIDGER_EMBED_SCRIPT}"
        DEPENDS "${input_abs}" "${_BRIDGER_EMBED_SCRIPT}"
        COMMENT "Embedding ${input} as ${symbol}"
        VERBATIM)
    target_sources(${target} PRIVATE "${output}")
endfunction()

# Script mode: invoked by the custom command above.
if(CMAKE_SCRIPT_MODE_FILE AND DEFINED BRIDGER_EMBED_INPUT)
    file(READ "${BRIDGER_EMBED_INPUT}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Break long lines every 16 bytes to keep compilers happy.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" bytes "${bytes}")
    if(size EQUAL 0)
        set(bytes "0x00")
    endif()
    file(WRITE "${BRIDGER_EMBED_OUTPUT}"
"// Generated by cmake/EmbedResource.cmake — do not edit.\n#include <cstddef>\nnamespace bridger::embedded {\nextern const unsigned char ${BRIDGER_EMBED_SYMBOL}[];\nextern const std::size_t ${BRIDGER_EMBED_SYMBOL}_size;\nalignas(16) const unsigned char ${BRIDGER_EMBED_SYMBOL}[] = {\n${bytes}\n};\nconst std::size_t ${BRIDGER_EMBED_SYMBOL}_size = ${size};\n} // namespace bridger::embedded\n")
endif()
