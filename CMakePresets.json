{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      },
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "clangcl",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": "msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": "msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC RelWithDebInfo + AddressSanitizer",
      "inherits": "msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BRIDGER_ENABLE_ASAN": "ON",
        "BRIDGER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "clangcl-release",
      "displayName": "clang-cl Release",
      "inherits": "clangcl",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clangcl-fuzz",
      "displayName": "clang-cl libFuzzer + AddressSanitizer",
      "inherits": "clangcl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed_static",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "BRIDGER_BUILD_FUZZERS": "ON",
        "BRIDGER_BUILD_CLI": "OFF",
        "BRIDGER_BUILD_TESTS": "OFF",
        "BRIDGER_BUILD_BENCHMARKS": "OFF",
        "BRIDGER_BUILD_APP": "OFF",
        "BRIDGER_BUILD_RENDER": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-asan", "configurePreset": "msvc-asan" },
    { "name": "clangcl-release", "configurePreset": "clangcl-release" },
    { "name": "clangcl-fuzz", "configurePreset": "clangcl-fuzz" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "msvc-debug", "inherits": "test-base", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "inherits": "test-base", "configurePreset": "msvc-release" },
    { "name": "msvc-asan", "inherits": "test-base", "configurePreset": "msvc-asan" },
    { "name": "clangcl-release", "inherits": "test-base", "configurePreset": "clangcl-release" }
  ]
}
