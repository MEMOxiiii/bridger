{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "bridger",
  "version-semver": "1.2.0",
  "description": "High-performance Minecraft format converter and 3D viewer",
  "license": "MPL-2.0",
  "dependencies": [
    {
      "name": "libdeflate",
      "default-features": false,
      "features": [
        "compression",
        "decompression",
        "gzip",
        "zlib"
      ]
    },
    {
      "name": "minizip-ng",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "zlib",
    "tbb",
    "tl-expected",
    "xxhash",
    "spdlog",
    "cli11"
  ],
  "default-features": [
    "render",
    "app",
    "tests",
    "benchmarks",
    "tracy"
  ],
  "features": {
    "render": {
      "description": "Vulkan renderer (bridger_render)",
      "dependencies": [
        "volk",
        "vk-bootstrap",
        "vulkan-memory-allocator",
        {
          "name": "glslang",
          "features": [
            "tools"
          ]
        },
        "glm",
        "stb",
        "nlohmann-json"
      ]
    },
    "app": {
      "description": "Desktop app: on Windows SDL3 + WebView2 (docs/adr/0009); Linux and macOS use the system web view (docs/adr/0010)",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ],
          "platform": "windows"
        },
        {
          "name": "webview2",
          "platform": "windows"
        },
        {
          "name": "wil",
          "platform": "windows"
        }
      ]
    },
    "tests": {
      "description": "Unit tests",
      "dependencies": [
        "catch2",
        "nlohmann-json"
      ]
    },
    "benchmarks": {
      "description": "Benchmarks",
      "dependencies": [
        "benchmark"
      ]
    },
    "tracy": {
      "description": "Tracy profiler client (used with BRIDGER_ENABLE_TRACY=ON)",
      "dependencies": [
        "tracy"
      ]
    }
  }
}
